{
  "manifest_version": 3,
  "name": "tabscry bridge",
  "version": "0.3.0",
  "description": "Bridges Google AI Mode to the tabscry terminal client over ws://127.0.0.1:8765",
  "permissions": ["tabs", "scripting", "alarms", "storage", "offscreen", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://www.google.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/search*"],
      "js": ["page.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
